# 只填写域名，不要带 https://、端口或路径，例如 api.example.com
API_DOMAIN=api.example.com

# 生产环境必须更换为高强度随机值
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# 腾讯位置服务 WebService Key
TENCENT_MAP_KEY=replace-with-tencent-map-webservice-key

# 微信登录与支付配置（未正式接入支付时可暂时留空）
WX_APPID=
WX_APPSECRET=
WX_MERCHANT_ID=
WX_PAY_KEY=
