/* pages/tracking/tracking.wxss - 订单追踪页样式 */

/* ===== 自定义导航栏 ===== */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(180deg, #0d2540 0%, #0a1628 100%);
  border-bottom: 1rpx solid rgba(0, 212, 255, 0.1);
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid #e8eef5;
  border-bottom: 4rpx solid #e8eef5;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #e8eef5;
}

.nav-placeholder {
  width: 64rpx;
}

/* ===== 加载状态 ===== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #1e3556;
  border-top-color: #00d4ff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #5a6a7a;
}

/* ===== 状态横幅 ===== */
.status-banner {
  position: relative;
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  padding: 40rpx 32rpx;
}

.status-banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.12) 0%, rgba(16, 185, 129, 0.08) 100%);
  border: 1rpx solid rgba(0, 212, 255, 0.2);
  border-radius: 24rpx;
}

.status-banner.cancelled .status-banner-bg {
  background: linear-gradient(135deg, rgba(239, 68, 68, 0.12) 0%, rgba(239, 68, 68, 0.05) 100%);
  border-color: rgba(239, 68, 68, 0.2);
}

.status-banner.completed .status-banner-bg {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(16, 185, 129, 0.05) 100%);
  border-color: rgba(16, 185, 129, 0.2);
}

.status-banner-content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
}

.status-icon-wrap {
  margin-right: 24rpx;
}

.status-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-icon.pulse {
  background: rgba(245, 158, 11, 0.2);
  border: 2rpx solid #f59e0b;
  box-shadow: 0 0 20rpx rgba(245, 158, 11, 0.3);
}

.status-icon.pulse::after {
  content: '';
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #f59e0b;
}

.status-icon.en-route {
  background: rgba(0, 212, 255, 0.2);
  border: 2rpx solid #00d4ff;
}

.status-icon.en-route::after {
  content: '';
  width: 24rpx;
  height: 16rpx;
  background: #00d4ff;
  border-radius: 4rpx 12rpx 12rpx 4rpx;
}

.status-icon.arrived {
  background: rgba(139, 92, 246, 0.2);
  border: 2rpx solid #8b5cf6;
}

.status-icon.arrived::after {
  content: '';
  width: 24rpx;
  height: 24rpx;
  border-radius: 50% 50% 50% 0;
  background: #8b5cf6;
  transform: rotate(-45deg);
}

.status-icon.charging {
  background: rgba(16, 185, 129, 0.2);
  border: 2rpx solid #10b981;
}

.status-icon.charging::after {
  content: '';
  width: 20rpx;
  height: 28rpx;
  background: #10b981;
  clip-path: polygon(60% 0%, 0% 60%, 40% 60%, 30% 100%, 100% 35%, 55% 35%);
}

.status-icon.completed {
  background: rgba(16, 185, 129, 0.2);
  border: 2rpx solid #10b981;
}

.status-icon.completed::after {
  content: '';
  width: 18rpx;
  height: 10rpx;
  border-left: 4rpx solid #10b981;
  border-bottom: 4rpx solid #10b981;
  transform: rotate(-45deg);
  margin-top: -8rpx;
}

.status-text-wrap {
  display: flex;
  flex-direction: column;
}

.status-main {
  font-size: 36rpx;
  font-weight: 700;
  color: #e8eef5;
}

.status-sub {
  font-size: 24rpx;
  color: #8b9bb0;
  margin-top: 8rpx;
}

/* ===== 状态进度条 ===== */
.progress-section {
  margin: 0 24rpx 24rpx;
  background: linear-gradient(135deg, #112441 0%, #0d1b2e 100%);
  border: 1rpx solid #1e3556;
  border-radius: 24rpx;
  padding: 40rpx 24rpx 32rpx;
}

.progress-track {
  position: relative;
  height: 4rpx;
  background: #1e3556;
  margin-bottom: 32rpx;
  border-radius: 2rpx;
}

.progress-line {
  position: absolute;
  top: 0;
  height: 4rpx;
  background: #1e3556;
  border-radius: 2rpx;
}

.progress-line.active {
  background: linear-gradient(90deg, #00d4ff, #10b981);
}

.progress-steps {
  display: flex;
  justify-content: space-between;
  position: relative;
  margin-top: -56rpx;
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20%;
}

.step-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #1e3556;
  border: 4rpx solid #0a1628;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  z-index: 2;
  position: relative;
}

.step-dot.active {
  background: #00d4ff;
  border-color: #0a1628;
  box-shadow: 0 0 12rpx rgba(0, 212, 255, 0.5);
}

.step-dot.current {
  background: #00d4ff;
  border-color: #0a1628;
  box-shadow: 0 0 16rpx rgba(0, 212, 255, 0.6);
  animation: pulse 1.5s ease-in-out infinite;
}

.step-dot-inner {
  width: 10rpx;
  height: 6rpx;
  border-left: 3rpx solid #0a1628;
  border-bottom: 3rpx solid #0a1628;
  transform: rotate(-45deg);
  margin-top: -2rpx;
}

.step-label {
  font-size: 20rpx;
  color: #5a6a7a;
  text-align: center;
  white-space: nowrap;
}

.step-label.active {
  color: #00d4ff;
  font-weight: 600;
}

/* ===== 地图 ===== */
.map-section {
  margin: 0 24rpx 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid #1e3556;
}

.order-map {
  width: 100%;
  height: 360rpx;
}

/* ===== 救援员卡片 ===== */
.driver-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 24rpx;
  background: linear-gradient(135deg, #112441 0%, #0d1b2e 100%);
  border: 1rpx solid #1e3556;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
}

.driver-info {
  display: flex;
  align-items: center;
}

.driver-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #00d4ff 0%, #10b981 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #0a1628;
}

.driver-details {
  display: flex;
  flex-direction: column;
}

.driver-name-row {
  display: flex;
  align-items: center;
}

.driver-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #e8eef5;
  margin-right: 16rpx;
}

.driver-rating {
  display: flex;
  align-items: center;
}

.star-icon {
  width: 20rpx;
  height: 20rpx;
  background: #f59e0b;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  margin-right: 4rpx;
}

.rating-text {
  font-size: 24rpx;
  color: #f59e0b;
  font-weight: 600;
}

.driver-tag {
  font-size: 22rpx;
  color: #5a6a7a;
  margin-top: 4rpx;
}

.driver-call-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.call-icon-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(16, 185, 129, 0.15);
  border: 1rpx solid rgba(16, 185, 129, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.call-icon {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 3rpx solid #10b981;
  position: relative;
}

.call-icon::after {
  content: '';
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #10b981;
}

.call-text {
  font-size: 20rpx;
  color: #10b981;
}

/* ===== 订单详情 ===== */
.detail-card {
  margin: 0 24rpx 24rpx;
  background: linear-gradient(135deg, #112441 0%, #0d1b2e 100%);
  border: 1rpx solid #1e3556;
  border-radius: 24rpx;
  padding: 32rpx;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.detail-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #e8eef5;
}

.order-no {
  font-size: 22rpx;
  color: #5a6a7a;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
}

.detail-label {
  font-size: 26rpx;
  color: #8b9bb0;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #e8eef5;
  text-align: right;
  font-weight: 500;
  max-width: 60%;
}

.detail-value.addr {
  max-width: 65%;
  word-break: break-all;
}

.detail-divider {
  height: 1rpx;
  background: #1e3556;
  margin: 8rpx 0;
}

.detail-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
}

.total-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #e8eef5;
}

.total-amount {
  display: flex;
  align-items: baseline;
}

.total-currency {
  font-size: 28rpx;
  color: #00d4ff;
}

.total-value {
  font-size: 48rpx;
  font-weight: 800;
  color: #00d4ff;
  margin-left: 4rpx;
}

.payment-status {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.pay-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.pay-dot.paid {
  background: #10b981;
  box-shadow: 0 0 8rpx #10b981;
}

.pay-dot.unpaid {
  background: #ef4444;
  box-shadow: 0 0 8rpx #ef4444;
}

.payment-status text {
  font-size: 24rpx;
  color: #8b9bb0;
}

/* ===== 时间线 ===== */
.timeline-card {
  margin: 0 24rpx 24rpx;
  background: linear-gradient(135deg, #112441 0%, #0d1b2e 100%);
  border: 1rpx solid #1e3556;
  border-radius: 24rpx;
  padding: 32rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  position: relative;
  padding-bottom: 32rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background: #1e3556;
}

.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #1e3556;
  border: 3rpx solid #0a1628;
  flex-shrink: 0;
  margin-right: 24rpx;
  margin-top: 4rpx;
  z-index: 2;
}

.timeline-dot.arrived {
  background: #8b5cf6;
  box-shadow: 0 0 8rpx rgba(139, 92, 246, 0.5);
}

.timeline-dot.charging {
  background: #10b981;
  box-shadow: 0 0 8rpx rgba(16, 185, 129, 0.5);
}

.timeline-dot.completed {
  background: #00d4ff;
  box-shadow: 0 0 8rpx rgba(0, 212, 255, 0.5);
}

.timeline-content {
  display: flex;
  flex-direction: column;
}

.timeline-label {
  font-size: 26rpx;
  color: #8b9bb0;
}

.timeline-time {
  font-size: 24rpx;
  color: #e8eef5;
  margin-top: 4rpx;
}

/* ===== 操作按钮区域 ===== */
.action-section {
  padding: 0 24rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.charging-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(16, 185, 129, 0.1);
  border: 1rpx solid rgba(16, 185, 129, 0.25);
  border-radius: 16rpx;
  padding: 24rpx;
}

.charging-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #10b981;
  margin-right: 16rpx;
  box-shadow: 0 0 12rpx #10b981;
}

.charging-hint text {
  font-size: 28rpx;
  color: #10b981;
}

/* ===== 已评价区域 ===== */
.rated-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(0, 212, 255, 0.05);
  border: 1rpx solid rgba(0, 212, 255, 0.15);
  border-radius: 16rpx;
  padding: 24rpx;
}

.rated-stars {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.star-filled .star {
  width: 32rpx;
  height: 32rpx;
  background: #1e3556;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

.star-filled .star.active {
  background: #f59e0b;
}

.rated-comment {
  font-size: 26rpx;
  color: #8b9bb0;
  text-align: center;
}

/* ===== 评价弹窗 ===== */
.rate-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.rate-modal {
  width: 100%;
  background: linear-gradient(180deg, #0d2540 0%, #0a1628 100%);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.rate-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.rate-modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e8eef5;
}

.rate-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-icon {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.close-icon::before,
.close-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 3rpx;
  background: #8b9bb0;
}

.close-icon::before {
  transform: rotate(45deg);
}

.close-icon::after {
  transform: rotate(-45deg);
}

.rate-stars {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.rate-star-wrap {
  padding: 8rpx;
}

.rate-star {
  width: 48rpx;
  height: 48rpx;
  background: #1e3556;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  transition: all 0.2s;
}

.rate-star.active {
  background: #f59e0b;
  box-shadow: 0 0 12rpx rgba(245, 158, 11, 0.4);
}

.rate-text {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #8b9bb0;
  margin-bottom: 32rpx;
}

.rate-textarea {
  width: 100%;
  min-height: 160rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid #1e3556;
  border-radius: 20rpx;
  padding: 24rpx;
  color: #e8eef5;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}
