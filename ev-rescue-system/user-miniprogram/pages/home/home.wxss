/* pages/home/home.wxss - 首页样式 */

/* ===== 顶部横幅 ===== */
.hero-section {
  position: relative;
  padding: 40rpx 40rpx 60rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #0d2540 0%, #0a1628 100%);
}

.hero-bg-glow {
  position: absolute;
  top: -120rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(0, 212, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.hero-bg-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: linear-gradient(rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx),
                    linear-gradient(90deg, rgba(0, 212, 255, 0.03) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
}

.hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-badge {
  display: flex;
  align-items: center;
  background: rgba(0, 212, 255, 0.1);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
  border-radius: 40rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 32rpx;
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #00d4ff;
  margin-right: 12rpx;
  box-shadow: 0 0 12rpx #00d4ff;
}

.badge-text {
  font-size: 24rpx;
  color: #00d4ff;
  font-weight: 600;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #e8eef5;
  line-height: 1.3;
  text-align: center;
}

.hero-title.accent {
  font-size: 44rpx;
  background: linear-gradient(135deg, #00d4ff 0%, #10b981 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-top: 8rpx;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
  margin-top: 32rpx;
}

.hero-tag {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}

.hero-tag text {
  font-size: 22rpx;
  color: #8b9bb0;
  margin-left: 8rpx;
}

.tag-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.tag-dot.green {
  background: #10b981;
  box-shadow: 0 0 8rpx rgba(16, 185, 129, 0.6);
}

.tag-dot.cyan {
  background: #00d4ff;
  box-shadow: 0 0 8rpx rgba(0, 212, 255, 0.6);
}

.night-tip {
  margin-top: 24rpx;
  background: rgba(245, 158, 11, 0.1);
  border: 1rpx solid rgba(245, 158, 11, 0.25);
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
}

.night-tip-text {
  font-size: 22rpx;
  color: #f59e0b;
}

/* ===== 进行中订单条 ===== */
.active-order-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.15) 0%, rgba(16, 185, 129, 0.15) 100%);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  margin-top: 24rpx;
}

.active-order-left {
  display: flex;
  align-items: center;
}

.active-pulse {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #00d4ff;
  margin-right: 16rpx;
  box-shadow: 0 0 12rpx #00d4ff;
  animation: pulse 1.5s ease-in-out infinite;
}

.active-text {
  font-size: 28rpx;
  color: #00d4ff;
  font-weight: 600;
}

.active-arrow {
  font-size: 26rpx;
  color: #00d4ff;
}

/* ===== 通用section ===== */
.section {
  padding: 0 24rpx;
  margin-top: 48rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e8eef5;
  margin-bottom: 8rpx;
}

.section-subtitle {
  margin-bottom: 24rpx;
}

.section-subtitle text {
  font-size: 24rpx;
  color: #5a6a7a;
}

/* ===== 服务特点网格 ===== */
.features-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.feature-item {
  width: calc(50% - 12rpx);
  background: linear-gradient(135deg, #112441 0%, #0d1b2e 100%);
  border: 1rpx solid #1e3556;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.feature-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.icon-power {
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.2), rgba(0, 212, 255, 0.05));
  border: 1rpx solid rgba(0, 212, 255, 0.3);
}

.icon-speed {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(16, 185, 129, 0.05));
  border: 1rpx solid rgba(16, 185, 129, 0.3);
}

.icon-rescue {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(139, 92, 246, 0.05));
  border: 1rpx solid rgba(139, 92, 246, 0.3);
}

.icon-safe {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(245, 158, 11, 0.05));
  border: 1rpx solid rgba(245, 158, 11, 0.3);
}

/* CSS图标 */
.icon-bolt {
  width: 32rpx;
  height: 40rpx;
  background: #00d4ff;
  clip-path: polygon(60% 0%, 0% 60%, 40% 60%, 30% 100%, 100% 35%, 55% 35%);
  box-shadow: 0 0 16rpx rgba(0, 212, 255, 0.5);
}

.icon-clock {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #10b981;
  border-radius: 50%;
  position: relative;
}

.icon-clock::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 12rpx;
  height: 4rpx;
  background: #10b981;
  transform-origin: left center;
  transform: translateY(-50%) rotate(-45deg);
}

.icon-clock::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 8rpx;
  height: 4rpx;
  background: #10b981;
  transform-origin: left center;
  transform: translateY(-50%) rotate(60deg);
}

.icon-truck {
  width: 40rpx;
  height: 28rpx;
  position: relative;
}

.icon-truck::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 24rpx;
  height: 20rpx;
  background: #a78bfa;
  border-radius: 4rpx;
}

.icon-truck::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 14rpx;
  height: 14rpx;
  background: #a78bfa;
  border-radius: 4rpx;
}

.icon-shield {
  width: 36rpx;
  height: 40rpx;
  background: #f59e0b;
  clip-path: polygon(50% 0%, 100% 20%, 100% 60%, 50% 100%, 0% 60%, 0% 20%);
}

.feature-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #e8eef5;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #5a6a7a;
}

/* ===== 定价卡片 ===== */
.pricing-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pricing-card {
  background: linear-gradient(135deg, #112441 0%, #0d1b2e 100%);
  border: 1rpx solid #1e3556;
  border-radius: 24rpx;
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}

.pricing-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, #00d4ff, transparent);
}

.pricing-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.pricing-vehicle {
  display: flex;
  align-items: center;
}

.vehicle-icon-small,
.vehicle-icon-medium,
.vehicle-icon-large {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  margin-right: 20rpx;
}

.vehicle-icon-small {
  background: rgba(0, 212, 255, 0.15);
  color: #00d4ff;
  border: 1rpx solid rgba(0, 212, 255, 0.3);
}

.vehicle-icon-medium {
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
  border: 1rpx solid rgba(16, 185, 129, 0.3);
}

.vehicle-icon-large {
  background: rgba(245, 158, 11, 0.15);
  color: #f59e0b;
  border: 1rpx solid rgba(245, 158, 11, 0.3);
}

.vehicle-info {
  display: flex;
  flex-direction: column;
}

.vehicle-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #e8eef5;
}

.vehicle-range {
  font-size: 22rpx;
  color: #5a6a7a;
  margin-top: 4rpx;
}

.pricing-body {
  display: flex;
  align-items: center;
}

.price-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  transition: all 0.2s;
}

.price-item.active {
  background: rgba(245, 158, 11, 0.08);
  border-radius: 16rpx;
}

.price-label {
  font-size: 24rpx;
  color: #5a6a7a;
  margin-bottom: 8rpx;
}

.price-value {
  font-size: 48rpx;
  font-weight: 800;
  color: #e8eef5;
  line-height: 1.2;
}

.price-item.active .price-value {
  color: #f59e0b;
}

.price-unit {
  font-size: 24rpx;
  color: #5a6a7a;
}

.price-divider {
  width: 1rpx;
  height: 80rpx;
  background: #1e3556;
}

.pricing-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: rgba(245, 158, 11, 0.15);
  border: 1rpx solid rgba(245, 158, 11, 0.3);
  border-radius: 12rpx;
  padding: 4rpx 16rpx;
}

.pricing-badge text {
  font-size: 20rpx;
  color: #f59e0b;
}

.pricing-notes {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.note-item {
  display: flex;
  align-items: center;
}

.note-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #00d4ff;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.note-item text {
  font-size: 24rpx;
  color: #5a6a7a;
}

/* ===== 一键救援按钮 ===== */
.rescue-section {
  padding: 48rpx 24rpx 32rpx;
}

.rescue-button {
  position: relative;
  width: 100%;
  height: 280rpx;
  border-radius: 36rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rescue-button-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #00d4ff 0%, #0891b2 50%, #10b981 100%);
}

.rescue-button-inner {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rescue-icon-wrap {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.rescue-pulse-ring {
  position: absolute;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(10, 22, 40, 0.3);
  animation: rescuePulse 2s ease-out infinite;
}

.rescue-pulse-ring.delay {
  animation-delay: 1s;
}

@keyframes rescuePulse {
  0% {
    transform: scale(0.8);
    opacity: 1;
  }
  100% {
    transform: scale(1.6);
    opacity: 0;
  }
}

.rescue-icon-center {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #0a1628;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rescue-bolt {
  width: 24rpx;
  height: 32rpx;
  background: #00d4ff;
  clip-path: polygon(60% 0%, 0% 60%, 40% 60%, 30% 100%, 100% 35%, 55% 35%);
  box-shadow: 0 0 12rpx #00d4ff;
}

.rescue-text {
  font-size: 40rpx;
  font-weight: 800;
  color: #0a1628;
  letter-spacing: 4rpx;
}

.rescue-subtext {
  font-size: 24rpx;
  color: rgba(10, 22, 40, 0.6);
  margin-top: 8rpx;
}

/* ===== 电话救援 ===== */
.phone-rescue {
  display: flex;
  align-items: center;
  background: rgba(20, 40, 70, 0.6);
  border: 1rpx solid rgba(0, 212, 255, 0.12);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  margin-top: 24rpx;
}

.phone-icon-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(16, 185, 129, 0.15);
  border: 1rpx solid rgba(16, 185, 129, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.phone-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 4rpx 12rpx 12rpx 4rpx;
  border: 4rpx solid #10b981;
  border-top: none;
  border-bottom-right-radius: 16rpx;
  position: relative;
}

.phone-icon::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #10b981;
}

.phone-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.phone-label {
  font-size: 26rpx;
  color: #8b9bb0;
}

.phone-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #10b981;
  margin-top: 4rpx;
}

.phone-arrow {
  font-size: 32rpx;
  color: #5a6a7a;
}

/* ===== 底部信息 ===== */
.footer-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 48rpx;
  gap: 8rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #3a4a5a;
}
