<!-- pages/login/login.wxml -->
<view class="login-page">
  <!-- 自定义状态栏占位 -->
  <view style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶部装饰背景 -->
  <view class="bg-decoration">
    <view class="bg-circle bg-circle-1"></view>
    <view class="bg-circle bg-circle-2"></view>
    <view class="bg-circle bg-circle-3"></view>
  </view>

  <!-- Logo区域 -->
  <view class="logo-section">
    <view class="logo-icon">
      <view class="logo-bolt">⚡</view>
    </view>
    <view class="logo-title">充电救援</view>
    <view class="logo-subtitle">司机端 · 新能源移动充电服务</view>
    <view class="logo-region">绵阳地区运营</view>
  </view>

  <!-- 表单区域 -->
  <view class="form-section">
    <view class="form-title">司机注册登录</view>

    <!-- 头像选择 -->
    <view class="avatar-section">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{avatar}}" class="avatar-img" src="{{avatar}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder">
          <text class="avatar-plus">+</text>
          <text class="avatar-tip">头像</text>
        </view>
      </button>
    </view>

    <!-- 手机号输入 -->
    <view class="input-group">
      <text class="input-label">手机号</text>
      <input
        class="input-field {{phoneError ? 'input-error' : ''}}"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        placeholder-class="placeholder"
        value="{{phone}}"
        bindinput="onPhoneInput"
        bindblur="onPhoneBlur"
      />
      <text wx:if="{{phoneError}}" class="error-text">{{phoneError}}</text>
    </view>

    <!-- 姓名输入 -->
    <view class="input-group">
      <text class="input-label">姓名</text>
      <input
        class="input-field {{nameError ? 'input-error' : ''}}"
        type="text"
        maxlength="20"
        placeholder="请输入真实姓名"
        placeholder-class="placeholder"
        value="{{name}}"
        bindinput="onNameInput"
        bindblur="onNameBlur"
      />
      <text wx:if="{{nameError}}" class="error-text">{{nameError}}</text>
    </view>

    <!-- 协议勾选 -->
    <view class="agreement-section">
      <checkbox-group bindchange="onAgreementChange">
        <label class="agreement-label">
          <checkbox value="agree" checked="{{agreed}}" color="#f59e0b" />
          <text class="agreement-text">我已阅读并同意</text>
          <text class="agreement-link">《司机服务协议》</text>
          <text class="agreement-text">和</text>
          <text class="agreement-link">《隐私政策》</text>
        </label>
      </checkbox-group>
    </view>

    <!-- 登录按钮 -->
    <button class="btn btn-primary btn-lg login-btn {{!agreed || logging ? 'btn-disabled' : ''}}" bindtap="onLogin" disabled="{{logging}}">
      <text wx:if="{{logging}}">登录中...</text>
      <text wx:else>注册并登录</text>
    </button>

    <!-- 提示信息 -->
    <view class="login-tips">
      <text class="tip-text">登录后将自动上线接单</text>
    </view>
  </view>
</view>
