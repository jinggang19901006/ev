/* pages/mine/mine.wxss */
.mine-page {
  min-height: 100vh;
  background: #0a1628;
  display: flex;
  flex-direction: column;
}

/* ===== 自定义导航栏 ===== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(180deg, #0d1b2e 0%, #0a1628 100%);
  border-bottom: 1rpx solid #1e3556;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #e8eef5;
}

/* ===== 滚动区域 ===== */
.mine-scroll {
  flex: 1;
  height: 0;
}

/* ===== 司机信息头部 ===== */
.profile-header {
  position: relative;
  padding: 48rpx 32rpx 32rpx;
  background: linear-gradient(180deg, #0d1b2e 0%, #0a1628 100%);
  overflow: hidden;
  border-bottom: 1rpx solid #1e3556;
}

.profile-bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  z-index: 0;
}

.profile-circle-1 {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(245, 158, 11, 0.08) 0%, transparent 70%);
  top: -100rpx;
  right: -80rpx;
}

.profile-circle-2 {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0, 212, 255, 0.06) 0%, transparent 70%);
  top: 50rpx;
  left: -60rpx;
}

.profile-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.avatar-box {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 28rpx;
  border: 4rpx solid #f59e0b;
  box-shadow: 0 0 24rpx rgba(245, 158, 11, 0.3);
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-default {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
}

.profile-detail {
  flex: 1;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.profile-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #e8eef5;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-badge.online {
  background: rgba(34, 197, 94, 0.15);
  color: #22c55e;
  border: 1rpx solid rgba(34, 197, 94, 0.3);
}

.status-badge.busy {
  background: rgba(245, 158, 11, 0.15);
  color: #f59e0b;
  border: 1rpx solid rgba(245, 158, 11, 0.3);
}

.status-badge.offline {
  background: rgba(138, 138, 138, 0.15);
  color: #888;
  border: 1rpx solid rgba(138, 138, 138, 0.3);
}

.status-badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.status-badge.online .status-badge-dot {
  box-shadow: 0 0 8rpx #22c55e;
}

.profile-phone {
  font-size: 26rpx;
  color: #8b9bb0;
  display: block;
  margin-bottom: 4rpx;
}

.profile-id {
  font-size: 22rpx;
  color: #5a6a7a;
}

/* 状态切换按钮 */
.status-switch-btn {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 20rpx 28rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  border: 1rpx solid #1e3556;
}

.status-switch-btn:active {
  background: rgba(255, 255, 255, 0.08);
}

.switch-text {
  font-size: 28rpx;
  color: #e8eef5;
  font-weight: 600;
}

.switch-arrow {
  font-size: 36rpx;
  color: #5a6a7a;
}

/* ===== Tab切换 ===== */
.tab-bar {
  display: flex;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #1e3556;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #8b9bb0;
  position: relative;
  transition: all 0.2s ease;
}

.tab-item.tab-active {
  color: #f59e0b;
  font-weight: 700;
}

.tab-item.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #f59e0b, #d97706);
  border-radius: 2rpx;
}

/* ===== 收入统计 ===== */
.tab-content {
  padding: 24rpx;
}

.income-card {
  position: relative;
  overflow: hidden;
}

.income-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
}

.income-today::before {
  background: linear-gradient(180deg, #f59e0b, #d97706);
}

.income-month::before {
  background: linear-gradient(180deg, #00d4ff, #0891b2);
}

.income-total::before {
  background: linear-gradient(180deg, #22c55e, #16a34a);
}

.income-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.income-card-title {
  font-size: 28rpx;
  color: #8b9bb0;
  font-weight: 600;
}

.income-card-date {
  font-size: 22rpx;
  color: #22c55e;
}

.income-card-rate {
  font-size: 22rpx;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.income-card-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.income-amount-symbol {
  font-size: 36rpx;
  font-weight: 600;
  margin-right: 4rpx;
}

.income-today .income-amount-symbol {
  color: #f59e0b;
}

.income-month .income-amount-symbol {
  color: #00d4ff;
}

.income-total .income-amount-symbol {
  color: #22c55e;
}

.income-amount-value {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
}

.income-today .income-amount-value {
  color: #f59e0b;
  text-shadow: 0 0 24rpx rgba(245, 158, 11, 0.2);
}

.income-month .income-amount-value {
  color: #00d4ff;
  text-shadow: 0 0 24rpx rgba(0, 212, 255, 0.2);
}

.income-total .income-amount-value {
  color: #22c55e;
  text-shadow: 0 0 24rpx rgba(34, 197, 94, 0.2);
}

.income-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.income-order-count {
  font-size: 24rpx;
  color: #5a6a7a;
}

/* ===== 统计概览 ===== */
.stats-overview {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats-value {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}

.stats-label {
  font-size: 22rpx;
  color: #8b9bb0;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: #1e3556;
}

/* ===== 订单历史 ===== */
.order-history-list {
  padding: 0;
}

.history-card {
  background: linear-gradient(135deg, #112441 0%, #0d1b2e 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #1e3556;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.history-card:active {
  transform: scale(0.99);
  transition: transform 0.1s ease;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.history-vehicle {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.history-vehicle-icon {
  font-size: 36rpx;
}

.history-vehicle-model {
  font-size: 30rpx;
  font-weight: 700;
  color: #e8eef5;
}

.history-address {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.history-address-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.history-address-text {
  font-size: 26rpx;
  color: #8b9bb0;
  line-height: 1.4;
  flex: 1;
  word-break: break-all;
}

.history-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #1e3556;
}

.history-time {
  font-size: 24rpx;
  color: #5a6a7a;
}

.history-income {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.history-income-label {
  font-size: 22rpx;
  color: #8b9bb0;
}

.history-income-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #f59e0b;
}

/* ===== 加载更多 ===== */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  gap: 12rpx;
}

.loading-spinner-sm {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #1e3556;
  border-top-color: #f59e0b;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

/* ===== 功能菜单 ===== */
.menu-section {
  padding: 0;
  margin: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 20rpx;
}

.menu-item:active {
  background: rgba(255, 255, 255, 0.03);
}

.menu-icon {
  font-size: 36rpx;
  width: 48rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #e8eef5;
}

.menu-arrow {
  font-size: 40rpx;
  color: #5a6a7a;
}

.menu-divider {
  height: 1rpx;
  background: #1e3556;
  margin-left: 100rpx;
}

/* ===== 退出登录 ===== */
.logout-section {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.logout-btn {
  width: 100%;
}

/* ===== 状态选择弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 22, 40, 0.8);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.status-picker-content {
  width: 100%;
  background: linear-gradient(180deg, #112441 0%, #0d1b2e 100%);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #2a4566;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.picker-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e8eef5;
}

.picker-close {
  font-size: 40rpx;
  color: #5a6a7a;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.picker-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 20rpx;
  border: 2rpx solid #1e3556;
  transition: all 0.2s ease;
}

.picker-option:active {
  background: rgba(255, 255, 255, 0.06);
}

.picker-option.option-active {
  background: rgba(245, 158, 11, 0.08);
  border-color: #f59e0b;
}

.option-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.option-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
}

.option-dot.online {
  background: #22c55e;
  box-shadow: 0 0 12rpx rgba(34, 197, 94, 0.4);
}

.option-dot.busy {
  background: #f59e0b;
  box-shadow: 0 0 12rpx rgba(245, 158, 11, 0.4);
}

.option-dot.offline {
  background: #5a6a7a;
}

.option-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.option-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #e8eef5;
}

.option-desc {
  font-size: 24rpx;
  color: #8b9bb0;
}

.option-check {
  font-size: 36rpx;
  color: #f59e0b;
  font-weight: 700;
}

/* ===== 空状态/底部 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.list-footer {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #3a4a5a;
}
