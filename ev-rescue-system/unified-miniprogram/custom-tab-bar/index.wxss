/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-start;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #0a1628;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.35);
}

.tab-item {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  height: 100rpx;
  box-sizing: border-box;
}

.active-indicator {
  position: absolute;
  top: 0;
  left: 50%;
  width: 40rpx;
  height: 4rpx;
  border-radius: 0 0 4rpx 4rpx;
  background: transparent;
  opacity: 0;
  transform: translateX(-50%) scaleX(0.4);
  transition: transform 200ms cubic-bezier(0.25, 1, 0.5, 1), opacity 200ms cubic-bezier(0.25, 1, 0.5, 1);
}

.tab-item.on .active-indicator {
  background: currentColor;
  opacity: 1;
  transform: translateX(-50%) scaleX(1);
}

.tab-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  transition: transform 150ms cubic-bezier(0.25, 1, 0.5, 1);
}

.icon-home .icon-shape {
  position: absolute;
  left: 7rpx;
  bottom: 4rpx;
  width: 28rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-top: none;
  border-radius: 3rpx;
  box-sizing: border-box;
}

.icon-home::before,
.icon-home::after {
  content: '';
  position: absolute;
  top: 7rpx;
  width: 25rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.icon-home::before {
  left: 1rpx;
  transform: rotate(-40deg);
  transform-origin: right center;
}

.icon-home::after {
  right: 1rpx;
  transform: rotate(40deg);
  transform-origin: left center;
}

.icon-orders .icon-shape {
  position: absolute;
  left: 6rpx;
  top: 7rpx;
  width: 30rpx;
  height: 32rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
}

.icon-orders::before {
  content: '';
  position: absolute;
  z-index: 1;
  top: 3rpx;
  left: 13rpx;
  width: 16rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: currentColor;
}

.icon-orders::after {
  content: '';
  position: absolute;
  top: 18rpx;
  left: 13rpx;
  width: 16rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
  box-shadow: 0 9rpx 0 currentColor;
}

.icon-mine::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 13rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.icon-mine .icon-shape {
  position: absolute;
  left: 4rpx;
  bottom: 2rpx;
  width: 34rpx;
  height: 17rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 20rpx 20rpx 0 0;
  box-sizing: border-box;
}

.tab-text {
  font-size: 22rpx;
  line-height: 28rpx;
  color: currentColor;
}

.tab-item.on .tab-text {
  font-weight: 600;
}

.tab-item.on .tab-icon {
  transform: translateY(-2rpx);
}

@media (prefers-reduced-motion: reduce) {
  .active-indicator,
  .tab-icon {
    transition: none;
  }
}
