/* custom-tab-bar/index.wxss */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #0a1628;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.35);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  height: 100rpx;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
}

.tab-text {
  font-size: 22rpx;
  line-height: 1.2;
}

.tab-item.on .tab-text {
  font-weight: 600;
}
