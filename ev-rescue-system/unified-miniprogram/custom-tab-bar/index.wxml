<!-- custom-tab-bar/index.wxml -->
<view class="tab-bar {{role}}">
  <view
    class="tab-item {{selected === index ? 'on' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
    style="color: {{selected === index ? selectedColor : color}};"
  >
    <view class="active-indicator"></view>
    <view class="tab-icon icon-{{item.iconType}}">
      <view class="icon-shape"></view>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
