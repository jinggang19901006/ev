<!-- custom-tab-bar/index.wxml -->
<view class="tab-bar">
  <view
    class="tab-item {{selected === index ? 'on' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image
      wx:if="{{item.icon}}"
      class="tab-icon"
      src="{{selected === index ? item.iconActive : item.icon}}"
      mode="aspectFit"
    ></image>
    <text
      class="tab-text"
      style="color: {{selected === index ? selectedColor : color}};"
    >{{item.text}}</text>
  </view>
</view>
