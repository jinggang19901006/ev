/* pages/detail/detail.wxss */
.detail-page {
  min-height: 100vh;
  background: #0a1628;
  display: flex;
  flex-direction: column;
}

/* ===== 自定义导航栏 ===== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: linear-gradient(180deg, #0d1b2e 0%, #0a1628 100%);
  border-bottom: 1rpx solid #1e3556;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
}

.nav-back:active {
  background: rgba(255, 255, 255, 0.1);
}

.back-icon {
  font-size: 48rpx;
  color: #e8eef5;
  line-height: 1;
}

.nav-title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #e8eef5;
}

.nav-placeholder {
  width: 64rpx;
}

/* ===== 滚动区域 ===== */
.detail-scroll {
  flex: 1;
  height: 0;
  padding: 24rpx;
}

/* ===== 加载状态 ===== */
.loading-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #1e3556;
  border-top-color: #f59e0b;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #5a6a7a;
}

/* ===== 状态进度条 ===== */
.status-progress {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 32rpx 16rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, rgba(17, 36, 65, 0.6) 0%, rgba(13, 27, 46, 0.6) 100%);
  border-radius: 24rpx;
  border: 1rpx solid #1e3556;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  position: relative;
}

.step-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #1a2e4a;
  border: 2rpx solid #2a4566;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
  z-index: 1;
}

.step-icon {
  font-size: 28rpx;
  color: #5a6a7a;
}

.step-active .step-circle {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  border-color: #f59e0b;
  box-shadow: 0 0 16rpx rgba(245, 158, 11, 0.4);
}

.step-active .step-icon {
  color: #fff;
}

.step-current .step-circle {
  animation: pulse-circle 2s ease-in-out infinite;
}

@keyframes pulse-circle {
  0%, 100% { box-shadow: 0 0 16rpx rgba(245, 158, 11, 0.4); }
  50% { box-shadow: 0 0 32rpx rgba(245, 158, 11, 0.6); }
}

.step-label {
  font-size: 20rpx;
  color: #5a6a7a;
  text-align: center;
}

.step-active .step-label {
  color: #f59e0b;
  font-weight: 600;
}

.step-line {
  position: absolute;
  top: 32rpx;
  left: 50%;
  width: 100%;
  height: 4rpx;
  background: #2a4566;
  z-index: 0;
}

.step-line.line-active {
  background: linear-gradient(90deg, #f59e0b 0%, #d97706 100%);
}

/* ===== 订单信息卡片 ===== */
.order-info-card {
  padding: 32rpx;
}

.order-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.order-vehicle-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.vehicle-icon-lg {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.vehicle-detail {
  display: flex;
  flex-direction: column;
}

.vehicle-model-lg {
  font-size: 38rpx;
  font-weight: 700;
  color: #e8eef5;
  margin-bottom: 4rpx;
}

.vehicle-plate-lg {
  font-size: 26rpx;
  color: #00d4ff;
  background: rgba(0, 212, 255, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.2);
  align-self: flex-start;
}

.order-price-box {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 32rpx;
  color: #f59e0b;
  font-weight: 600;
}

.price-amount {
  font-size: 60rpx;
  font-weight: 800;
  color: #f59e0b;
  text-shadow: 0 0 20rpx rgba(245, 158, 11, 0.3);
  line-height: 1;
}

/* ===== 信息列表 ===== */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.info-icon {
  font-size: 28rpx;
  width: 40rpx;
  flex-shrink: 0;
}

.info-key {
  font-size: 26rpx;
  color: #8b9bb0;
  width: 140rpx;
  flex-shrink: 0;
}

.info-val {
  font-size: 28rpx;
  color: #e8eef5;
  font-weight: 500;
  flex: 1;
}

/* 地址行 */
.address-row {
  align-items: flex-start;
  padding: 16rpx;
  margin: -16rpx;
  border-radius: 14rpx;
}

.address-row:active {
  background: rgba(56, 189, 248, 0.08);
}

.address-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.address-text-lg {
  font-size: 30rpx;
  color: #e8eef5;
  line-height: 1.5;
  word-break: break-all;
}

.detail-nav-btn {
  display: flex;
  min-width: 82rpx;
  height: 64rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  align-self: center;
  border: 1rpx solid rgba(56, 189, 248, 0.35);
  border-radius: 32rpx;
  color: #38bdf8;
  font-size: 22rpx;
}

.detail-nav-icon {
  display: inline-block;
  transform: rotate(-25deg);
}

.remark-row {
  align-items: flex-start;
}

.remark-text {
  font-size: 26rpx;
  color: #8b9bb0;
  line-height: 1.5;
}

/* ===== 联系按钮 ===== */
.contact-section {
  margin-bottom: 24rpx;
}

.contact-btn {
  width: 100%;
}

/* ===== 收入卡片 ===== */
.income-card {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(17, 36, 65, 0.8) 100%);
  border: 1rpx solid rgba(245, 158, 11, 0.2);
}

.income-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.income-title {
  font-size: 28rpx;
  color: #8b9bb0;
}

.income-rate {
  font-size: 22rpx;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.income-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.income-symbol {
  font-size: 32rpx;
  color: #f59e0b;
  font-weight: 600;
}

.income-value {
  font-size: 64rpx;
  font-weight: 800;
  color: #f59e0b;
  text-shadow: 0 0 24rpx rgba(245, 158, 11, 0.3);
  line-height: 1;
}

.income-detail-text {
  font-size: 22rpx;
  color: #5a6a7a;
}

/* ===== 操作区域 ===== */
.action-section {
  margin-top: 16rpx;
}

.action-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #e8eef5;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.action-card {
  background: linear-gradient(135deg, #112441 0%, #0d1b2e 100%);
  border-radius: 28rpx;
  padding: 32rpx;
  border: 1rpx solid #1e3556;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.4);
}

.action-step-info {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.action-step-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  box-shadow: 0 0 16rpx rgba(245, 158, 11, 0.3);
}

.action-step-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.action-step-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #e8eef5;
  margin-bottom: 4rpx;
}

.action-step-desc {
  font-size: 24rpx;
  color: #8b9bb0;
}

.action-btn {
  width: 100%;
  min-height: 100rpx;
  height: auto;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  line-height: 1.3;
  white-space: normal;
}

.action-btn-label {
  display: block;
  width: 100%;
  color: inherit;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
}

/* ===== 照片预览 ===== */
.photo-preview {
  position: relative;
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid #1e3556;
}

.photo-preview image {
  width: 100%;
  height: 100%;
}

.photo-label {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  color: #fff;
  font-size: 24rpx;
}

/* ===== 完成状态 ===== */
.completed-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.completed-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  color: #fff;
  font-size: 64rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 0 32rpx rgba(34, 197, 94, 0.4);
}

.cancelled-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(239, 68, 68, 0.15);
  border: 2rpx solid #ef4444;
  color: #ef4444;
  font-size: 64rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.completed-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e8eef5;
  margin-bottom: 12rpx;
}

.completed-desc {
  font-size: 26rpx;
  color: #8b9bb0;
}

/* ===== 额外费用弹窗 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10, 22, 40, 0.8);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  width: 100%;
  background: linear-gradient(180deg, #112441 0%, #0d1b2e 100%);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #2a4566;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e8eef5;
}

.modal-close {
  font-size: 40rpx;
  color: #5a6a7a;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  margin-bottom: 32rpx;
}

/* 费用项 */
.fee-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #1e3556;
}

.fee-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  color: #e8eef5;
}

.fee-icon {
  font-size: 32rpx;
}

.fee-input-box {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid #1e3556;
  border-radius: 16rpx;
  padding: 0 24rpx;
  width: 240rpx;
  height: 80rpx;
}

.fee-unit {
  font-size: 28rpx;
  color: #f59e0b;
  margin-right: 8rpx;
}

.fee-input {
  flex: 1;
  height: 80rpx;
  color: #e8eef5;
  font-size: 32rpx;
  font-weight: 600;
}

.fee-placeholder {
  color: #5a6a7a;
}

/* 备注项 */
.fee-remark-item {
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
}

.fee-remark-input {
  width: 100%;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid #1e3556;
  border-radius: 16rpx;
  padding: 0 24rpx;
  color: #e8eef5;
  font-size: 28rpx;
}

/* 合计 */
.fee-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  margin-top: 16rpx;
}

.fee-total-label {
  font-size: 30rpx;
  color: #8b9bb0;
}

.fee-total-amount {
  font-size: 48rpx;
  font-weight: 800;
  color: #f59e0b;
}

/* 弹窗底部按钮 */
.modal-footer {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
}
