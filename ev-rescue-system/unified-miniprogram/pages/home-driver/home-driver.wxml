<!-- pages/home-driver/home-driver.wxml (1:1 老 driver orders.wxml) -->
<view class="orders-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar" style="height: {{navBarHeight}}px; padding-right: {{navRightPadding}}px;">
      <view class="nav-title">
        <text class="nav-title-text">订单大厅</text>
        <view class="nav-subtitle">绵阳 · 充电救援</view>
      </view>
      <!-- 上线/下线开关 -->
      <view class="status-toggle {{toggling ? 'toggling' : ''}}" bindtap="onToggleStatus">
        <view class="toggle-track {{driverStatus === 'online' ? 'track-on' : 'track-off'}}">
          <view class="toggle-thumb {{driverStatus === 'online' ? 'thumb-on' : 'thumb-off'}}"></view>
        </view>
        <text class="toggle-label {{driverStatus === 'online' ? 'label-on' : 'label-off'}}">
          {{driverStatus === 'online' ? '在线' : driverStatus === 'busy' ? '忙碌' : '离线'}}
        </text>
      </view>
    </view>
  </view>

  <!-- 状态栏占位 -->
  <view style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <!-- 状态提示条 -->
  <view class="status-bar {{driverStatus}}">
    <view class="status-dot {{driverStatus}}"></view>
    <text class="status-text">
      {{driverStatus === 'online' ? '在线接单中 · 新订单自动刷新' : driverStatus === 'busy' ? '正在服务中' : '已下线 · 点击右上角开关上线'}}
    </text>
    <text wx:if="{{driverStatus === 'online' && orders.length > 0}}" class="order-count">{{orders.length}}个待接单</text>
  </view>

  <view
    wx:if="{{driverStatus === 'online' && locationState !== 'ready' && locationState !== 'unknown'}}"
    class="location-alert {{locationState}}"
    bindtap="onRetryLocation"
  >
    <view class="location-alert-icon">{{locationUpdating ? '···' : '!'}}</view>
    <text class="location-alert-text">{{locationMessage || '定位需要更新'}}</text>
    <text class="location-alert-action">{{locationUpdating ? '更新中' : '重试 ›'}}</text>
  </view>

  <!-- 内容区域 -->
  <scroll-view scroll-y class="orders-scroll" enhanced show-scrollbar="{{false}}">

    <!-- 审核中状态 -->
    <view wx:if="{{notApproved}}" class="offline-state">
      <view class="offline-icon">⏳</view>
      <view class="offline-title">账号审核中</view>
      <view class="offline-desc">您的资料已提交，管理员审核通过后即可接单</view>
      <view class="offline-tip">如有疑问，请拨打运营电话咨询</view>
    </view>

    <!-- 离线状态 -->
    <view wx:elif="{{driverStatus === 'offline'}}" class="offline-state">
      <view class="offline-icon">💤</view>
      <view class="offline-title">当前已下线</view>
      <view class="offline-desc">上线后即可接收新的充电救援订单</view>
      <button class="btn btn-primary btn-lg offline-btn" bindtap="onToggleStatus">
        立即上线
      </button>
    </view>

    <!-- 忙碌状态 -->
    <view wx:elif="{{driverStatus === 'busy'}}" class="busy-state">
      <view wx:if="{{activeOrder}}" class="active-order-card" bindtap="onGoToActiveOrder">
        <view class="busy-icon">🔧</view>
        <view class="busy-info">
          <text class="busy-title">正在服务中</text>
          <text class="busy-desc">{{activeOrder.vehicleModel}} · {{activeOrder.plateNumber || '无牌'}}</text>
          <text class="busy-address">📍 {{activeOrder.address}}</text>
        </view>
        <view class="busy-arrow">›</view>
      </view>
      <view wx:else class="offline-state">
        <view class="offline-icon">⏳</view>
        <view class="offline-title">正在同步状态...</view>
        <view class="offline-desc">正在获取您的订单信息</view>
      </view>
    </view>

    <!-- 在线状态 - 订单列表 -->
    <block wx:else>
      <!-- 加载中 -->
      <view wx:if="{{loading && orders.length === 0}}" class="loading-state">
        <view class="loading-spinner"></view>
        <text class="loading-text">正在加载订单...</text>
      </view>

      <!-- 空列表 -->
      <view wx:elif="{{orders.length === 0}}" class="empty-state">
        <view class="listening-radar">
          <view class="radar-grid"></view>
          <view class="radar-ring radar-ring-outer"></view>
          <view class="radar-ring radar-ring-middle"></view>
          <view class="radar-sweep"></view>
          <view class="radar-signal signal-one"></view>
          <view class="radar-signal signal-two"></view>
          <view class="radar-core">
            <text class="radar-bolt">⚡</text>
          </view>
        </view>
        <view class="listening-title-row">
          <text class="empty-title">正在听单</text>
          <view class="listening-dots">
            <view class="listening-dot dot-one"></view>
            <view class="listening-dot dot-two"></view>
            <view class="listening-dot dot-three"></view>
          </view>
        </view>
        <text class="empty-subtitle">持续扫描附近救援需求，每10秒自动刷新</text>
        <view class="empty-tips">
          <view class="empty-tip-item">
            <text class="tip-icon">✓</text>
            <text class="tip-text">保持在线状态</text>
          </view>
          <view class="empty-tip-item">
            <text class="tip-icon">✓</text>
            <text class="tip-text">确保网络畅通</text>
          </view>
          <view class="empty-tip-item">
            <text class="tip-icon">✓</text>
            <text class="tip-text">位置信息准确</text>
          </view>
        </view>
      </view>

      <!-- 订单列表 -->
      <view wx:else class="orders-list">
        <view 
          wx:for="{{orders}}" 
          wx:key="id" 
          class="order-card"
          data-id="{{item.id}}"
        >
          <!-- 卡片状态与时间 -->
          <view class="order-card-meta">
            <view class="card-top-badge">
              <text class="badge-dot"></text>
              <text class="badge-text">新订单</text>
            </view>
            <view class="order-time-info">
              <text class="time-clock-icon">🕐</text>
              <text class="time-display-text">{{item.createTimeText || '刚刚'}}</text>
            </view>
          </view>

          <!-- 卡片头部：车型 + 价格 -->
          <view class="order-card-header">
            <view class="order-vehicle-section">
              <view class="vehicle-icon-box">
                <text class="vehicle-icon-emoji">🚗</text>
              </view>
              <view class="vehicle-info-box">
                <text class="vehicle-model-name">{{item.vehicleModel}}</text>
                <text wx:if="{{item.plateNumber}}" class="vehicle-plate-tag">{{item.plateNumber}}</text>
              </view>
            </view>
            <view class="order-price-section">
              <text class="price-currency">¥</text>
              <text class="price-number">{{item.price}}</text>
              <text class="price-unit">元</text>
            </view>
          </view>

          <!-- 充电信息标签 -->
          <view class="order-info-tags">
            <view wx:if="{{item.batteryLevel}}" class="info-tag tag-danger">
              <text class="tag-icon">🔋</text>
              <text class="tag-text">电量 {{item.batteryLevel}}%</text>
            </view>
            <view wx:if="{{item.chargeAmount}}" class="info-tag tag-cyan">
              <text class="tag-icon">⚡</text>
              <text class="tag-text">{{item.chargeAmount}}度</text>
            </view>
            <view class="info-tag tag-normal">
              <text class="tag-icon">📍</text>
              <text class="tag-text">{{item.distance}}</text>
            </view>
          </view>

          <!-- 地址信息 -->
          <view class="order-address-box" catchtap="onNavigate" data-id="{{item.id}}">
            <view class="address-icon-box">
              <text class="address-marker">📍</text>
            </view>
            <view class="address-content-box">
              <text class="address-label">救援地址</text>
              <text class="address-detail-text">{{item.address}}</text>
            </view>
            <view class="address-nav">
              <text class="address-nav-icon">➤</text>
              <text class="address-nav-text">导航</text>
            </view>
          </view>

          <!-- 卡片底部：明确分离查看、联系与接单 -->
          <view class="order-card-footer">
            <view class="order-action-buttons">
              <button
                class="action-btn-ghost"
                catchtap="onViewOrder"
                data-id="{{item.id}}"
              >详情</button>
              <button 
                wx:if="{{item.phone}}" 
                class="action-btn-outline" 
                catchtap="onCallPhone"
                data-phone="{{item.phone}}"
              >
                <text class="btn-phone-icon">📞</text>
                联系
              </button>
              <button
                class="action-btn-outline action-btn-nav"
                catchtap="onNavigate"
                data-id="{{item.id}}"
              >导航</button>
              <button 
                class="action-btn-primary {{acceptingId === item.id ? 'btn-loading' : ''}}"
                catchtap="onAcceptOrder"
                data-id="{{item.id}}"
                disabled="{{acceptingId !== ''}}"
              >
                {{acceptingId === item.id ? '接单中...' : '立即接单'}}
              </button>
            </view>
          </view>
        </view>

        <!-- 底部提示 -->
        <view class="list-footer">
          <view class="footer-divider"></view>
          <text class="footer-text">已显示全部 {{orders.length}} 个待接单订单</text>
          <view class="footer-divider"></view>
        </view>
      </view>
    </block>

    <!-- 底部安全区 -->
    <view style="height: 120rpx;"></view>
  </scroll-view>
</view>
