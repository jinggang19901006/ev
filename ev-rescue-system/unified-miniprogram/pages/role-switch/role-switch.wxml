<view class="page">
  <view class="tip">同一账号可切换「普通车主」和「救援司机」两个身份。</view>
  <view class="card">
    <view class="item {{currentRole==='user' ? 'on' : ''}}" bindtap="switchTo" data-role="user">
      <view class="icon">🚗</view>
      <view class="info">
        <view class="name">普通车主 <text wx:if="{{roles.includes('user') && currentRole!=='user'}}" class="tag">已开通</text>
          <text wx:if="{{currentRole==='user'}}" class="tag me">当前</text>
          <text wx:if="{{!roles.includes('user')}}" class="tag off">未开通</text></view>
        <view class="desc">呼叫救援、管理订单、支付评价</view>
      </view>
      <view wx:if="{{!roles.includes('user')}}" class="btn-mini" catchtap="addRole" data-role="user">去开通</view>
    </view>

    <view class="item {{currentRole==='driver' ? 'on' : ''}}" bindtap="switchTo" data-role="driver">
      <view class="icon">🛠️</view>
      <view class="info">
        <view class="name">救援司机 <text wx:if="{{roles.includes('driver') && currentRole!=='driver'}}" class="tag">已开通</text>
          <text wx:if="{{currentRole==='driver'}}" class="tag me">当前</text>
          <text wx:if="{{!roles.includes('driver')}}" class="tag off">未开通</text></view>
        <view class="desc">接单赚收入、查看提现、服务等级</view>
      </view>
      <view wx:if="{{!roles.includes('driver')}}" class="btn-mini" catchtap="addRole" data-role="driver">去开通</view>
    </view>
  </view>
  <view wx:if="{{loading}}" class="loading">切换中…</view>
</view>
