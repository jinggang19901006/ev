.page { min-height:100vh; background:#0a1628; color:#fff; padding:32rpx; }
.tip { color:#8aa0bf; font-size:26rpx; margin-bottom:24rpx; }
.card { background: rgba(255,255,255,0.05); border-radius:20rpx; padding:16rpx; border:1rpx solid rgba(255,255,255,0.08); }
.item { display:flex; gap:20rpx; align-items:center; padding:24rpx; border-radius:16rpx; margin-bottom:12rpx; background: rgba(255,255,255,0.02); }
.item.on { background: linear-gradient(135deg, rgba(0,212,255,0.15), rgba(59,130,246,0.15)); border:1rpx solid rgba(0,212,255,0.5); }
.icon { font-size:56rpx; }
.info { flex:1; }
.name { font-size:30rpx; font-weight:500; }
.desc { color:#8aa0bf; font-size:24rpx; margin-top:6rpx; }
.tag { font-size:20rpx; padding:2rpx 14rpx; border-radius:999rpx; margin-left:10rpx; background: rgba(52,211,153,0.15); color:#6ee7b7;}
.tag.me { background: linear-gradient(90deg,#00d4ff,#3b82f6); color:#fff;}
.tag.off { background: rgba(248,113,113,0.1); color:#fca5a5;}
.btn-mini { font-size:24rpx; padding: 12rpx 20rpx; border-radius: 999rpx; background: rgba(0,212,255,0.18); color:#6fe1ff; }
.loading { text-align:center; color:#8aa0bf; margin-top: 32rpx;}
