/* pages/auth-entry/auth-entry.wxss — 1:1 老 driver login 样式 + 身份 2 选 1 追加 + .btn 统一兜底 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a1628 0%, #0d1b2e 50%, #0a1628 100%);
  position: relative;
  overflow: hidden;
  padding: 0 48rpx;
  padding-bottom: 80rpx;
}

/* ===== 背景装饰（3 圆：橙/青/橙 radial-gradient） ===== */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 600rpx;
  overflow: hidden;
  z-index: 0;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.08;
}

.bg-circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, #f59e0b 0%, transparent 70%);
  top: -100rpx;
  right: -100rpx;
}

.bg-circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, #00d4ff 0%, transparent 70%);
  top: 200rpx;
  left: -80rpx;
}

.bg-circle-3 {
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, #f59e0b 0%, transparent 70%);
  top: 350rpx;
  right: 50rpx;
  opacity: 0.05;
}

/* ===== Logo 区域（橙闪电方块 + 4 行标题） ===== */
.logo-section {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  padding-bottom: 60rpx;
}

.logo-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(245, 158, 11, 0.4);
  margin-bottom: 32rpx;
}

.logo-bolt {
  font-size: 72rpx;
  line-height: 1;
}

.logo-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #e8eef5;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.logo-subtitle {
  font-size: 26rpx;
  color: #8b9bb0;
  margin-bottom: 8rpx;
}

.logo-region {
  font-size: 22rpx;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.1);
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(245, 158, 11, 0.2);
}

/* ===== 表单玻璃卡片 ===== */
.form-section {
  position: relative;
  z-index: 1;
  background: linear-gradient(135deg, rgba(17, 36, 65, 0.8) 0%, rgba(13, 27, 46, 0.8) 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  border: 1rpx solid #1e3556;
  backdrop-filter: blur(20rpx);
}

.form-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e8eef5;
  margin-bottom: 40rpx;
  text-align: center;
}

/* ===== 【唯一新增】身份 2 选 1（radio-group 双卡片） ===== */
.role-selection {
  margin-bottom: 36rpx;
}

.role-label {
  font-size: 28rpx;
  color: #8b9bb0;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.role-radio-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.role-radio-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 2rpx solid #1e3556;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.role-radio-item.active.user {
  border-color: #00d4ff;
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.08) 0%, rgba(13, 27, 46, 0.6) 100%);
  box-shadow: 0 0 20rpx rgba(0, 212, 255, 0.2);
}

.role-radio-item.active.driver {
  border-color: #f59e0b;
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(13, 27, 46, 0.6) 100%);
  box-shadow: 0 0 20rpx rgba(245, 158, 11, 0.2);
}

.role-radio-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  flex-shrink: 0;
}

.role-radio-icon.user-icon {
  background: rgba(0, 212, 255, 0.12);
  border: 1rpx solid rgba(0, 212, 255, 0.3);
}

.role-radio-icon.driver-icon {
  background: rgba(245, 158, 11, 0.12);
  border: 1rpx solid rgba(245, 158, 11, 0.3);
}

.role-radio-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.role-radio-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #e8eef5;
}

.role-radio-desc {
  font-size: 22rpx;
  color: #5a6a7a;
}

.role-radio-dot {
  flex-shrink: 0;
  transform: scale(1.1);
}

/* ===== 输入框组 ===== */
.placeholder {
  color: #5a6a7a;
}

.input-group {
  margin-bottom: 28rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: #8b9bb0;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.input-field {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid #1e3556;
  border-radius: 16rpx;
  color: #e8eef5;
  font-size: 30rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.input-error {
  border-color: #ef4444 !important;
  background: rgba(239, 68, 68, 0.05);
}

.error-text {
  display: block;
  color: #ef4444;
  font-size: 24rpx;
  margin-top: 12rpx;
  padding-left: 8rpx;
}

/* ===== 按钮通用（老双端共用统一兜底） ===== */
.btn {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  border: none;
  font-weight: 500;
  padding: 0;
  box-sizing: border-box;
  transition: opacity 0.2s ease, transform 0.1s ease;
}

.btn::after {
  border: none;
}

.btn:active {
  transform: scale(0.98);
}

.btn-lg {
  height: 96rpx;
  line-height: 96rpx;
}

.btn-primary {
  color: #fff;
  background: linear-gradient(90deg, #f59e0b 0%, #d97706 100%);
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.3);
}

.btn-wx {
  color: #fff;
  background: linear-gradient(90deg, #07c160 0%, #06ad56 100%);
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
}

.btn-outline {
  color: #8b9bb0;
  background: transparent;
  border: 2rpx solid #2a4566 !important;
  box-sizing: border-box;
}

.btn-disabled {
  opacity: 0.55 !important;
  box-shadow: none !important;
  transform: none !important;
}

.wx-icon {
  display: inline-block;
  margin-right: 12rpx;
}

.login-btn {
  width: 100%;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 提示 ===== */
.login-tips {
  display: flex;
  justify-content: center;
  margin-top: 32rpx;
  text-align: center;
}

.tip-text {
  font-size: 24rpx;
  color: #5a6a7a;
  line-height: 1.6;
}

/* pulse 动画兜底（老 UI 部分 warning-dot 使用） */
.pulse {
  animation: pulse 1.4s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* spin 加载动画兜底（老页面通用） */
@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
