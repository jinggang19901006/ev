.page { background:#0a1628; min-height:100vh; color:#fff; padding:24rpx 28rpx 80rpx;}
.hero { padding:28rpx; border-radius:20rpx; background: linear-gradient(135deg,#fde68a,#f59e0b); color:#5b3a00; margin-bottom:28rpx; box-shadow: 0 10rpx 40rpx rgba(245,158,11,0.25);}
.top { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:20rpx;}
.top .n { font-size:32rpx; font-weight:600; }
.top .d { font-size:56rpx; font-weight:700; }
.row { display:flex; justify-content:space-between; font-size:24rpx; opacity:0.9;}
.row2 { display:flex; justify-content:space-between; align-items:center; margin-top:10rpx;}
.st { font-size:22rpx; padding:4rpx 14rpx; border-radius:999rpx; background: rgba(6,95,70,0.2); color:#065f46;}
.st-used, .st-redeemed { background: rgba(127,29,29,0.2); color:#7f1d1d;}
.st-expired { background: rgba(75,85,99,0.3); color:#4b5563;}
.desc { margin-top:20rpx; font-size:24rpx; opacity:0.85; line-height:1.6;}
.sec { background: rgba(255,255,255,0.04); border-radius:18rpx; padding:24rpx;}
.sec-title { font-size:26rpx; color:#aac1e0; margin-bottom: 16rpx;}
.u { padding:16rpx 0; border-bottom: 1rpx dashed rgba(255,255,255,0.1);}
.u:last-child { border-bottom: none; }
.u-top { display:flex; justify-content:space-between; font-size:28rpx;}
.u-top .ok { color:#6ee7b7;}
.u-bottom { margin-top:8rpx; color:#8aa0bf; font-size:22rpx; display:flex; justify-content:space-between;}
.empty { text-align:center; padding: 30rpx 0; color:#5b7597; font-size:24rpx;}
