<view class="page">
  <view class="banner">
    <view class="role-chip">{{roleText}}登录</view>
    <view class="hint">老用户走验证码登录，新用户请点下方「没有账号？去注册」</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="label">手机号</view>
      <input class="input" type="number" maxlength="11" value="{{phone}}"
        data-key="phone" bindinput="onInput" placeholder="请输入手机号"/>
    </view>

    <view class="field">
      <view class="label">短信验证码</view>
      <view class="row">
        <input class="input code" type="number" maxlength="6" value="{{code}}"
          data-key="code" bindinput="onInput" placeholder="开发环境固定 1234"/>
        <button class="btn sms" size="mini" disabled="{{sending}}" bindtap="onSendSms">
          {{sending ? (counter + 's') : '获取验证码'}}
        </button>
      </view>
    </view>

    <button class="btn primary" loading="{{loading}}" bindtap="onTapLogin">登录</button>
    <view class="split"><text>其它方式</text></view>
    <button class="btn ghost" bindtap="goRegister">没有账号？去注册</button>
  </view>

  <view class="footer-tip">
    登录即表示同意《用户协议》与《隐私政策》· 热线 15228301555
  </view>
</view>
