.page { min-height:100vh; padding:48rpx 32rpx 120rpx; background:#0a1628; color:#fff; }
.banner { margin-bottom:36rpx; }
.role-chip { display:inline-block; padding: 8rpx 20rpx; border-radius:999rpx; background: linear-gradient(90deg,#34d399,#10b981); color:#fff; font-size:26rpx; font-weight:500; }
.hint { margin-top:18rpx; color:#8aa0bf; font-size:26rpx; line-height:1.6;}

.card { background: rgba(255,255,255,0.05); border:1rpx solid rgba(255,255,255,0.08); border-radius:20rpx; padding:36rpx 28rpx; }
.field { margin-bottom:28rpx; }
.label { color:#aac1e0; font-size:24rpx; margin-bottom:12rpx; }
.input { background: rgba(255,255,255,0.06); border-radius:14rpx; padding:0 24rpx; height:88rpx; color:#fff; font-size:30rpx; }
.row { display:flex; gap:16rpx; align-items:center;}
.row .input.code { flex:1; }
.btn.sms { width:200rpx; height:70rpx; line-height:70rpx; background:rgba(16,185,129,0.15); color:#6ee7b7; border-radius:14rpx; border:none; font-size:24rpx; padding:0;}
.btn.sms[disabled] { opacity:0.6; color:#8aa0bf;}

.avatar-btn { background: rgba(255,255,255,0.05); border-radius:14rpx; height:160rpx; line-height:160rpx; padding:0; border:none; color:#9db7db;}
.avatar { width:120rpx; height:120rpx; border-radius:60rpx; margin-top:20rpx;}
.avatar-placeholder { color:#8aa0bf; font-size:26rpx;}

.warn-box { background: rgba(245,158,11,0.1); color:#fcd34d; border:1rpx solid rgba(245,158,11,0.3); border-radius:14rpx; padding:20rpx; font-size:24rpx; line-height:1.6; margin-bottom:24rpx;}

.agree { display:flex; gap:14rpx; align-items:flex-start; margin: 10rpx 0 28rpx; }
.agree .box { width:34rpx; height:34rpx; border-radius:8rpx; border:2rpx solid #5b7597; color:#0a1628; text-align:center; line-height:34rpx; font-size:22rpx; font-weight:700; flex-shrink:0; background:#0a1628;}
.agree .box.on { background: #00d4ff; border-color: #00d4ff; color:#fff; }
.agree .txt { flex:1; color:#8aa0bf; font-size:24rpx; line-height:1.6;}

.btn { height:88rpx; line-height:88rpx; border-radius:14rpx; font-size:30rpx; border:none; padding:0; margin-bottom:16rpx; }
.btn.primary { background: linear-gradient(90deg,#34d399,#10b981); color:#fff; font-weight:500;}
.btn.primary[disabled] { opacity:0.6; }
.btn.ghost { background:transparent; color:#9db7db; border:1rpx solid rgba(255,255,255,0.2);}
