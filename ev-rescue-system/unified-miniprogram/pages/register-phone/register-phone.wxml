<view class="page">
  <view class="banner">
    <view class="role-chip">{{roleText}} · 新用户注册</view>
    <view class="hint">
      {{openOnly ? '您的微信/手机号已存在，正在为您开通新角色：' : '首次使用请填写资料，完成后即可呼叫救援或接单赚钱'}}
    </view>
  </view>

  <view class="card">
    <view class="field">
      <view class="label">手机号</view>
      <input class="input" type="number" maxlength="11" value="{{phone}}" data-key="phone" bindinput="onInput" placeholder="请输入手机号"/>
    </view>

    <view class="field">
      <view class="label">短信验证码</view>
      <view class="row">
        <input class="input code" type="number" maxlength="6" value="{{code}}" data-key="code" bindinput="onInput" placeholder="开发环境固定 1234"/>
        <button class="btn sms" size="mini" disabled="{{sending}}" bindtap="onSendSms">
          {{sending ? (counter + 's') : '获取验证码'}}
        </button>
      </view>
    </view>

    <block wx:if="{{role === 'user'}}">
      <view class="field">
        <view class="label">头像</view>
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">
          <image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill"/>
          <view wx:else class="avatar-placeholder">点击选择头像</view>
        </button>
      </view>
      <view class="field">
        <view class="label">昵称</view>
        <input class="input" value="{{nickname}}" data-key="nickname" bindinput="onInput" placeholder="请输入昵称（如 张先生）"/>
      </view>
    </block>

    <block wx:if="{{role === 'driver'}}">
      <view class="field">
        <view class="label">真实姓名</view>
        <input class="input" value="{{name}}" data-key="name" bindinput="onInput" placeholder="救援司机姓名（实名）"/>
      </view>
      <view class="field">
        <view class="label">身份证号</view>
        <input class="input" value="{{idCard}}" data-key="idCard" bindinput="onInput" placeholder="18位身份证号（平台审核）"/>
      </view>
      <view class="field">
        <view class="label">救援车车牌号（选填）</view>
        <input class="input" value="{{licensePlate}}" data-key="licensePlate" bindinput="onInput" placeholder="如 川B·XXXXXX"/>
      </view>
      <view class="warn-box">司机账号注册后需管理员审核通过，审核期间司机端大厅不可接单</view>
    </block>

    <view class="agree" bindtap="toggleAgree">
      <view class="box {{agree ? 'on' : ''}}">{{agree ? '✓' : ''}}</view>
      <view class="txt">我已阅读并同意《用户协议》《隐私政策》以及平台救援/司机相关条款</view>
    </view>

    <button class="btn primary" loading="{{loading}}" bindtap="onTapRegister">立即注册并登录</button>
    <button class="btn ghost" bindtap="goLogin">已有账号？返回登录</button>
  </view>
</view>
