<!-- pages/mine/mine.wxml - 个人中心（统一端·角色感知：用户/司机） -->
<view class="container">
  <!-- 顶部背景区域 -->
  <view class="profile-header" style="padding-top: {{statusBarHeight + 20}}px;">
    <view class="header-bg-glow"></view>
    <view class="header-bg-grid"></view>

    <!-- 已登录·司机 -->
    <view class="profile-content" wx:if="{{isLoggedIn && role === 'driver'}}">
      <view class="avatar-wrap" bindtap="onChangeWorkStatus">
        <image wx:if="{{driver.avatar}}" class="avatar" src="{{driver.avatar}}" mode="aspectFill"></image>
        <view wx:else class="avatar avatar-default">
          <text class="avatar-placeholder">{{driver.name ? driver.name[0] : '司'}}</text>
        </view>
        <view class="avatar-ring"></view>
      </view>
      <view class="user-info">
        <text class="user-name">{{driver.name || '救援司机'}}</text>
        <view class="user-tags">
          <view class="driver-level-tag" style="border-color: {{driverLevel.badgeColor}};">
            <text style="color: {{driverLevel.badgeColor}};">{{driverLevel.code}}</text>
            <text>{{driverLevel.name}}</text>
          </view>
          <view class="user-tag" bindtap="onChangeWorkStatus">
            <view class="tag-dot {{driverStatus === 'online' ? 'green' : driverStatus === 'busy' ? 'orange' : 'gray'}}"></view>
            <text>{{driverStatus === 'online' ? '在线接单' : driverStatus === 'busy' ? '忙碌中' : '离线'}}</text>
          </view>
          <view class="user-tag" wx:if="{{driver.phone}}">
            <view class="tag-dot cyan"></view>
            <text>{{driver.phone}}</text>
          </view>
          <view class="user-tag" wx:if="{{driver.vehicle_plate || driver.plate_number || driver.car_number}}">
            <view class="tag-dot cyan"></view>
            <text>{{driver.vehicle_plate || driver.plate_number || driver.car_number}}</text>
          </view>
        </view>
      </view>
      <view class="logout-btn" catchtap="onLogout">
        <text>退出</text>
      </view>
    </view>

    <!-- 已登录·用户 -->
    <view class="profile-content" wx:if="{{isLoggedIn && role !== 'driver'}}">
      <view class="avatar-wrap">
        <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" catchtap="stopPropagation"></image>
        <view class="avatar-ring"></view>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickname || '绵阳用户'}}</text>
        <view class="user-tags">
          <view class="user-tag">
            <view class="tag-dot green"></view>
            <text>已认证</text>
          </view>
          <view class="user-tag" wx:if="{{userInfo.phone}}">
            <view class="tag-dot cyan"></view>
            <text>{{userInfo.phone}}</text>
          </view>
        </view>
      </view>
      <view class="logout-btn" catchtap="onLogout">
        <text>退出</text>
      </view>
    </view>

    <!-- 未登录 -->
    <view class="profile-content" wx:if="{{!isLoggedIn}}">
      <view class="avatar-wrap">
        <view class="avatar avatar-default">
          <text class="avatar-placeholder">用户</text>
        </view>
        <view class="avatar-ring"></view>
      </view>
      <view class="user-info">
        <text class="user-name">未登录</text>
        <view class="user-tags">
          <view class="user-tag">
            <view class="tag-dot cyan"></view>
            <text>点击登录享受服务</text>
          </view>
        </view>
      </view>
      <view class="login-btn" catchtap="onShowLogin">
        <text>登录</text>
      </view>
    </view>
  </view>

  <!-- 快捷入口·司机 -->
  <view class="quick-actions" wx:if="{{isLoggedIn && role === 'driver'}}">
    <view class="quick-item" bindtap="goHall">
      <view class="quick-icon icon-quick-order">
        <view class="quick-icon-inner"></view>
      </view>
      <text class="quick-text">订单大厅</text>
    </view>
    <view class="quick-item" bindtap="onChangeWorkStatus">
      <view class="quick-icon icon-quick-status">
        <view class="quick-icon-inner"></view>
      </view>
      <text class="quick-text">接单状态</text>
    </view>
    <view class="quick-item" bindtap="onMenuTap" data-path="phone">
      <view class="quick-icon icon-quick-phone">
        <view class="quick-icon-inner"></view>
      </view>
      <text class="quick-text">联系客服</text>
    </view>
  </view>

  <!-- 司机服务等级 -->
  <view class="section driver-level-section" wx:if="{{isLoggedIn && role === 'driver'}}">
    <view class="driver-level-panel" style="background: linear-gradient(110deg, {{driverLevel.gradientFrom}}, {{driverLevel.gradientTo}});">
      <view class="driver-level-head">
        <view class="driver-level-identity">
          <view class="driver-level-code" style="background: {{driverLevel.badgeColor}};">{{driverLevel.code}}</view>
          <view>
            <text class="driver-level-name">{{driverLevel.name}}</text>
            <text class="driver-level-next">{{driverLevel.nextText}}</text>
          </view>
        </view>
        <view class="driver-level-factor">
          <text>派单系数</text>
          <text>×{{driverLevel.coefficient}}</text>
        </view>
      </view>
      <view class="driver-level-progress">
        <view class="driver-level-progress-bar" style="width: {{driverLevel.progress}}%; background: {{driverLevel.badgeColor}};"></view>
      </view>
      <view class="driver-level-stats">
        <view><text>{{driverLevel.totalOrders}}</text><text>累计完成</text></view>
        <view><text>{{driverLevel.rating}}</text><text>当前评分</text></view>
        <view><text>{{driverLevel.acceptCount7d}}</text><text>近7日接单</text></view>
      </view>
    </view>
  </view>

  <!-- 快捷入口·用户（未登录同用户视图） -->
  <view class="quick-actions" wx:if="{{!(isLoggedIn && role === 'driver')}}">
    <view class="quick-item" bindtap="onMenuTap" data-path="orders">
      <view class="quick-icon icon-quick-order">
        <view class="quick-icon-inner"></view>
      </view>
      <text class="quick-text">我的订单</text>
    </view>
    <view class="quick-item" bindtap="goToOrder">
      <view class="quick-icon icon-quick-rescue">
        <view class="quick-icon-inner"></view>
      </view>
      <text class="quick-text">呼叫救援</text>
    </view>
    <view class="quick-item" bindtap="onMenuTap" data-path="phone">
      <view class="quick-icon icon-quick-phone">
        <view class="quick-icon-inner"></view>
      </view>
      <text class="quick-text">联系客服</text>
    </view>
  </view>

  <!-- 司机钱包 -->
  <view class="section" wx:if="{{isLoggedIn && role === 'driver'}}">
    <view class="wallet-card">
      <view class="wallet-head">
        <view>
          <text class="wallet-label">可提现余额</text>
          <view class="wallet-balance">
            <text class="wallet-symbol">¥</text>
            <text class="wallet-value">{{wallet.balance}}</text>
          </view>
        </view>
        <button class="wallet-withdraw-btn" bindtap="onOpenWithdraw">申请提现</button>
      </view>
      <view class="wallet-meta">
        <text>审核中 ¥{{wallet.frozenAmount}}</text>
        <text>累计收入 ¥{{wallet.totalEarnings}}</text>
        <text>最低提现 ¥{{wallet.minWithdrawAmount}}</text>
      </view>
    </view>

    <view class="withdraw-history" wx:if="{{wallet.withdrawals.length > 0}}">
      <view class="withdraw-history-title">最近提现</view>
      <view class="withdraw-record" wx:for="{{wallet.withdrawals}}" wx:key="id">
        <view class="withdraw-record-main">
          <view class="withdraw-record-top">
            <text class="withdraw-record-type">{{item.typeLabel}}</text>
            <text class="withdraw-status status-{{item.statusClass}}">{{item.statusLabel}}</text>
          </view>
          <text class="withdraw-record-time">{{item.createdAtText}}</text>
          <text class="withdraw-record-remark" wx:if="{{item.review_remark}}">{{item.review_remark}}</text>
        </view>
        <text class="withdraw-record-amount">-¥{{item.amount}}</text>
      </view>
    </view>
  </view>

  <!-- 司机收入统计 -->
  <view class="section" wx:if="{{isLoggedIn && role === 'driver'}}">
    <view class="section-header">
      <text class="section-title">收入统计</text>
      <text class="section-count settlement-pending" wx:if="{{hasPendingEarnings}}">待用户支付 ¥{{earnings.pendingAmount}}</text>
      <text class="section-count earn-switch" wx:else bindtap="onChangeWorkStatus">切换接单状态 ›</text>
    </view>
    <view class="earnings-grid">
      <view class="earning-card earn-today">
        <text class="earn-label">今日收入</text>
        <view class="earn-amount">
          <text class="earn-symbol">¥</text>
          <text class="earn-value">{{earnings.today.amount}}</text>
        </view>
        <text class="earn-sub">今日已结算 {{earnings.today.count}} 单</text>
      </view>
      <view class="earning-card earn-month">
        <text class="earn-label">本月收入</text>
        <view class="earn-amount">
          <text class="earn-symbol">¥</text>
          <text class="earn-value">{{earnings.month.amount}}</text>
        </view>
        <text class="earn-sub">本月已结算 {{earnings.month.count}} 单</text>
      </view>
      <view class="earning-card earn-total">
        <text class="earn-label">累计收入</text>
        <view class="earn-amount">
          <text class="earn-symbol">¥</text>
          <text class="earn-value">{{earnings.total.amount}}</text>
        </view>
        <text class="earn-sub">累计已结算 {{earnings.total.count}} 单</text>
      </view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="section">
    <view class="menu-list">
      <view class="menu-item" wx:for="{{menuList}}" wx:key="name" bindtap="onMenuTap" data-path="{{item.path}}">
        <view class="menu-icon-wrap">
          <view class="menu-icon icon-{{item.icon}}">
            <view class="menu-icon-inner icon-{{item.icon}}-inner"></view>
          </view>
        </view>
        <view class="menu-content">
          <text class="menu-name">{{item.name}}</text>
          <text class="menu-desc">{{item.desc}}</text>
        </view>
        <view class="menu-arrow">></view>
      </view>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer-info">
    <text class="footer-title">绵阳24小时新能源应急充电救援</text>
    <text class="footer-text">60kW直流移动充电救援 | 服务区域：绵阳及周边30公里</text>
    <text class="footer-text">救援电话：15228301555 | 7x24小时全年无休</text>
  </view>
</view>

<!-- 提现申请弹窗 -->
<view class="withdraw-modal-mask" wx:if="{{showWithdrawModal}}" catchtap="onCloseWithdraw">
  <view class="withdraw-modal" catchtap="stopPropagation">
    <view class="withdraw-modal-head">
      <view>
        <text class="withdraw-modal-title">申请提现</text>
        <text class="withdraw-modal-sub">提交后金额进入审核中，拒绝将自动退回</text>
      </view>
      <view class="withdraw-close" catchtap="onCloseWithdraw">
        <view class="close-icon"></view>
      </view>
    </view>

    <view class="withdraw-balance-tip">
      <text>可提现余额</text>
      <text>¥{{wallet.balance}}</text>
    </view>

    <view class="form-item">
      <text class="form-label">提现金额</text>
      <view class="withdraw-amount-input">
        <text class="withdraw-currency">¥</text>
        <input type="digit" value="{{withdrawAmount}}" placeholder="最低{{wallet.minWithdrawAmount}}元" placeholder-class="input-placeholder" bindinput="onWithdrawAmountInput" />
        <text class="withdraw-all" bindtap="onWithdrawAll">全部</text>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">收款方式</text>
      <picker mode="selector" range="{{withdrawTypes}}" range-key="label" value="{{withdrawTypeIndex}}" bindchange="onWithdrawTypeChange">
        <view class="withdraw-picker">
          <text>{{withdrawTypes[withdrawTypeIndex].label}}</text>
          <text class="withdraw-picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">收款人姓名</text>
      <input class="form-input" value="{{withdrawAccountName}}" maxlength="30" placeholder="请填写实名姓名" placeholder-class="input-placeholder" bindinput="onWithdrawNameInput" />
    </view>

    <view class="form-item">
      <text class="form-label">收款账号</text>
      <input class="form-input" value="{{withdrawAccount}}" maxlength="64" placeholder="微信号、支付宝账号或银行卡号" placeholder-class="input-placeholder" bindinput="onWithdrawAccountInput" />
    </view>

    <button class="withdraw-submit" loading="{{withdrawing}}" disabled="{{withdrawing}}" bindtap="onSubmitWithdraw">
      {{withdrawing ? '提交中...' : '确认申请提现'}}
    </button>
  </view>
</view>

<!-- 登录弹窗（保留壳，确认后跳统一登录页） -->
<view class="login-modal-mask" wx:if="{{showLoginModal}}" catchtap="onCloseLogin">
  <view class="login-modal" catchtap="stopPropagation">
    <view class="login-modal-bg-glow"></view>

    <!-- 关闭按钮 -->
    <view class="login-close" catchtap="onCloseLogin">
      <view class="close-icon"></view>
    </view>

    <!-- 标题 -->
    <view class="login-header">
      <view class="login-badge">
        <view class="badge-dot pulse"></view>
        <text>用户登录</text>
      </view>
      <text class="login-title">登录后享受完整服务</text>
    </view>

    <!-- 头像选择 -->
    <view class="login-form">
      <view class="form-item">
        <text class="form-label">头像</text>
        <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar-preview" src="{{tempAvatar || '/images/default-avatar.png'}}" mode="aspectFill" wx:if="{{tempAvatar}}"></image>
          <view class="avatar-placeholder" wx:if="{{!tempAvatar}}">
            <text>点击选择</text>
          </view>
        </button>
      </view>

      <view class="form-item">
        <text class="form-label">昵称</text>
        <input
          class="form-input"
          type="nickname"
          placeholder="请输入昵称"
          placeholder-class="input-placeholder"
          value="{{tempNickname}}"
          bindinput="onNicknameInput"
        />
      </view>

      <view class="form-item">
        <text class="form-label">手机号</text>
        <view class="phone-row">
          <button class="phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
            <view class="phone-btn-content">
              <text wx:if="{{tempPhone}}">已授权</text>
              <text wx:if="{{!tempPhone}}">点击授权</text>
            </view>
          </button>
          <text class="phone-or">或</text>
          <input
            class="phone-input"
            type="number"
            placeholder="手动输入手机号"
            placeholder-class="input-placeholder"
            value="{{tempPhone}}"
            bindinput="onPhoneInput"
            maxlength="11"
          />
        </view>
      </view>
    </view>

    <!-- 确认按钮 -->
    <view class="login-confirm">
      <button class="btn btn-primary btn-lg btn-block {{!canLogin ? 'btn-disabled' : ''}}" bindtap="onConfirmLogin" loading="{{logging}}" disabled="{{!canLogin}}">
        {{logging ? '登录中...' : '确认登录'}}
      </button>
    </view>

    <!-- 隐私协议 -->
    <view class="login-privacy">
      <text>登录即表示同意《用户协议》和《隐私政策》</text>
    </view>
  </view>
</view>
