/* pages/mine/mine.wxss - 个人中心样式 */

/* ===== 顶部背景区域 ===== */
.profile-header {
  position: relative;
  padding: 40rpx 32rpx 60rpx;
  background: linear-gradient(180deg, #0d1b2e 0%, #0a1628 100%);
  overflow: hidden;
}

.header-bg-glow {
  position: absolute;
  top: -100rpx;
  left: -50rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(0, 212, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.header-bg-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    linear-gradient(rgba(0, 212, 255, 0.04) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(0, 212, 255, 0.04) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
  pointer-events: none;
}

.profile-content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.avatar-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(0, 212, 255, 0.3);
  background: var(--color-card);
}

.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-card);
}

.avatar-placeholder {
  font-size: 28rpx;
  color: var(--color-text-muted);
}

.avatar-ring {
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border: 2rpx solid rgba(0, 212, 255, 0.2);
  border-radius: 50%;
  pointer-events: none;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
  display: block;
}

.user-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.user-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  background: rgba(0, 212, 255, 0.1);
  border-radius: 16rpx;
  border: 1rpx solid rgba(0, 212, 255, 0.15);
}

.user-tag text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-left: 8rpx;
}

.driver-level-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid;
  border-radius: 16rpx;
}

.driver-level-tag text {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.driver-level-tag text:first-child {
  font-weight: 800;
}

.tag-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.tag-dot.green {
  background: var(--color-success);
  box-shadow: 0 0 8rpx var(--color-success);
}

.tag-dot.cyan {
  background: var(--color-primary);
  box-shadow: 0 0 8rpx var(--color-primary);
}

.tag-dot.orange {
  background: var(--color-warning);
  box-shadow: 0 0 8rpx var(--color-warning);
}

.tag-dot.gray {
  background: var(--color-text-muted);
}

.login-btn {
  padding: 16rpx 40rpx;
  background: linear-gradient(135deg, #00d4ff 0%, #0891b2 100%);
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 212, 255, 0.35);
  flex-shrink: 0;
}

.login-btn text {
  color: #0a1628;
  font-size: 28rpx;
  font-weight: 600;
}

.login-btn:active {
  transform: scale(0.95);
}

.logout-btn {
  padding: 16rpx 32rpx;
  background: rgba(239, 68, 68, 0.15);
  border: 2rpx solid rgba(239, 68, 68, 0.3);
  border-radius: 40rpx;
  flex-shrink: 0;
}

.logout-btn text {
  color: var(--color-danger);
  font-size: 26rpx;
  font-weight: 600;
}

.logout-btn:active {
  background: rgba(239, 68, 68, 0.25);
}

/* ===== 快捷入口 ===== */
.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 24rpx;
  margin: -40rpx 24rpx 24rpx;
  background: linear-gradient(135deg, #112441 0%, #0d1b2e 100%);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
  position: relative;
  z-index: 10;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.quick-item:active {
  opacity: 0.7;
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-quick-order {
  background: rgba(0, 212, 255, 0.15);
  border: 2rpx solid rgba(0, 212, 255, 0.3);
}

.icon-quick-rescue {
  background: rgba(16, 185, 129, 0.15);
  border: 2rpx solid rgba(16, 185, 129, 0.3);
}

.icon-quick-phone {
  background: rgba(245, 158, 11, 0.15);
  border: 2rpx solid rgba(245, 158, 11, 0.3);
}

.icon-quick-status {
  background: rgba(139, 92, 246, 0.15);
  border: 2rpx solid rgba(139, 92, 246, 0.3);
}

.icon-quick-status .quick-icon-inner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #a78bfa;
  border-radius: 50%;
  position: relative;
}

.icon-quick-status .quick-icon-inner::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 10rpx;
  height: 10rpx;
  background: #a78bfa;
  border-radius: 50%;
}

.quick-icon-inner {
  width: 36rpx;
  height: 36rpx;
}

.icon-quick-order .quick-icon-inner {
  border: 3rpx solid var(--color-primary);
  border-radius: 6rpx;
  position: relative;
}

.icon-quick-order .quick-icon-inner::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  height: 8rpx;
  background: var(--color-primary);
}

.icon-quick-rescue .quick-icon-inner {
  background: var(--color-success);
  clip-path: polygon(40% 0%, 60% 0%, 60% 50%, 100% 50%, 50% 100%, 50% 60%, 0% 60%, 40% 60%);
}

.icon-quick-phone .quick-icon-inner {
  border: 3rpx solid var(--color-warning);
  border-radius: 4rpx 12rpx 12rpx 4rpx;
  position: relative;
}

.icon-quick-phone .quick-icon-inner::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 20%;
  transform: translateY(-50%);
  width: 40%;
  height: 40%;
  border: 2rpx solid var(--color-warning);
  border-radius: 50%;
}

.quick-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ===== 通用区块 ===== */
.section {
  margin: 0 24rpx 24rpx;
}

/* ===== 司机服务等级 ===== */
.driver-level-section {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.driver-level-panel {
  padding: 28rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 16rpx;
  color: #0f172a;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.08);
}

.driver-level-head,
.driver-level-identity,
.driver-level-stats {
  display: flex;
  align-items: center;
}

.driver-level-head {
  justify-content: space-between;
  gap: 20rpx;
}

.driver-level-identity {
  min-width: 0;
  gap: 18rpx;
}

.driver-level-code {
  width: 82rpx;
  height: 64rpx;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-align: center;
  flex-shrink: 0;
}

.driver-level-name,
.driver-level-next {
  display: block;
}

.driver-level-name {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
}

.driver-level-next {
  max-width: 400rpx;
  margin-top: 5rpx;
  color: #475569;
  font-size: 21rpx;
  line-height: 1.45;
}

.driver-level-factor {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.driver-level-factor text:first-child {
  color: #64748b;
  font-size: 20rpx;
}

.driver-level-factor text:last-child {
  margin-top: 2rpx;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 800;
}

.driver-level-progress {
  height: 10rpx;
  margin: 26rpx 0 22rpx;
  overflow: hidden;
  background: rgba(15, 23, 42, 0.12);
  border-radius: 5rpx;
}

.driver-level-progress-bar {
  height: 100%;
  min-width: 8rpx;
  border-radius: 5rpx;
  transition: width 0.35s ease;
}

.driver-level-stats {
  justify-content: space-between;
}

.driver-level-stats view {
  width: 33.333%;
  text-align: center;
  border-right: 2rpx solid rgba(15, 23, 42, 0.1);
}

.driver-level-stats view:last-child {
  border-right: 0;
}

.driver-level-stats text {
  display: block;
}

.driver-level-stats text:first-child {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
}

.driver-level-stats text:last-child {
  margin-top: 3rpx;
  color: #64748b;
  font-size: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}

.section-count {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ===== 司机钱包与提现 ===== */
.wallet-card {
  padding: 34rpx 32rpx 28rpx;
  border: 1rpx solid rgba(16, 185, 129, 0.28);
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.16), #0d1b2e 62%);
  box-shadow: var(--shadow-card);
}

.wallet-head,
.wallet-balance,
.wallet-meta,
.withdraw-record,
.withdraw-record-top,
.withdraw-modal-head,
.withdraw-balance-tip,
.withdraw-amount-input,
.withdraw-picker {
  display: flex;
  align-items: center;
}

.wallet-head,
.withdraw-record,
.withdraw-modal-head,
.withdraw-balance-tip,
.withdraw-picker {
  justify-content: space-between;
}

.wallet-label {
  display: block;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.wallet-balance {
  margin-top: 6rpx;
  align-items: baseline;
}

.wallet-symbol {
  margin-right: 6rpx;
  color: #6ee7b7;
  font-size: 30rpx;
  font-weight: 700;
}

.wallet-value {
  color: #ecfdf5;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.1;
}

.wallet-withdraw-btn {
  height: 68rpx;
  margin: 0;
  padding: 0 28rpx;
  border: none;
  border-radius: 34rpx;
  background: #10b981;
  color: #062c22;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.wallet-withdraw-btn::after,
.withdraw-submit::after {
  border: none;
}

.wallet-meta {
  flex-wrap: wrap;
  gap: 10rpx 24rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(110, 231, 183, 0.15);
}

.wallet-meta text {
  color: #7d948d;
  font-size: 22rpx;
}

.withdraw-history {
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: rgba(13, 27, 46, 0.72);
}

.withdraw-history-title {
  padding: 20rpx 24rpx 14rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.withdraw-record {
  min-height: 100rpx;
  padding: 18rpx 24rpx;
  border-top: 1rpx solid var(--color-border);
}

.withdraw-record-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.withdraw-record-top {
  gap: 12rpx;
  align-self: flex-start;
}

.withdraw-record-type {
  color: var(--color-text);
  font-size: 25rpx;
  font-weight: 600;
}

.withdraw-status {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
}

.status-pending { background: rgba(245, 158, 11, 0.14); color: #fbbf24; }
.status-paid { background: rgba(16, 185, 129, 0.14); color: #34d399; }
.status-rejected { background: rgba(239, 68, 68, 0.14); color: #f87171; }

.withdraw-record-time,
.withdraw-record-remark {
  margin-top: 4rpx;
  color: var(--color-text-muted);
  font-size: 21rpx;
}

.withdraw-record-remark {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.withdraw-record-amount {
  margin-left: 20rpx;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 700;
}

.withdraw-modal-mask {
  position: fixed;
  z-index: 1100;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.72);
}

.withdraw-modal {
  width: 100%;
  max-width: 640rpx;
  max-height: 90vh;
  overflow-y: auto;
  padding: 38rpx 36rpx 36rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  background: #10213a;
  box-shadow: 0 20rpx 70rpx rgba(0, 0, 0, 0.55);
  animation: modalSlideIn 300ms cubic-bezier(0.25, 1, 0.5, 1);
}

.withdraw-modal-head {
  margin-bottom: 28rpx;
}

.withdraw-modal-title,
.withdraw-modal-sub {
  display: block;
}

.withdraw-modal-title {
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 700;
}

.withdraw-modal-sub {
  margin-top: 4rpx;
  color: var(--color-text-muted);
  font-size: 21rpx;
}

.withdraw-close {
  width: 56rpx;
  height: 56rpx;
  padding: 12rpx;
  flex-shrink: 0;
}

.withdraw-balance-tip {
  margin-bottom: 28rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: rgba(16, 185, 129, 0.1);
  color: #6ee7b7;
  font-size: 24rpx;
}

.withdraw-amount-input,
.withdraw-picker {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.05);
}

.withdraw-currency {
  margin-right: 10rpx;
  color: var(--color-text);
  font-size: 34rpx;
}

.withdraw-amount-input input {
  min-width: 0;
  flex: 1;
  color: var(--color-text);
  font-size: 34rpx;
}

.withdraw-all {
  padding: 14rpx 0 14rpx 20rpx;
  color: var(--color-primary);
  font-size: 25rpx;
}

.withdraw-picker {
  color: var(--color-text);
  font-size: 28rpx;
}

.withdraw-picker-arrow {
  color: var(--color-text-muted);
  font-size: 36rpx;
}

.withdraw-submit {
  width: 100%;
  height: 88rpx;
  margin: 10rpx 0 0;
  border-radius: 18rpx;
  background: #10b981;
  color: #062c22;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.withdraw-submit[disabled] {
  opacity: 0.55;
}

/* ===== 司机收入统计 ===== */
.earn-switch {
  color: var(--color-warning);
  font-size: 24rpx;
}

.settlement-pending {
  color: #fbbf24;
  font-size: 22rpx;
  font-weight: 600;
}

.earnings-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.earning-card {
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.earning-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 6rpx;
}

.earn-today {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.12) 0%, #0d1b2e 60%);
}

.earn-today::before {
  background: var(--color-warning);
}

.earn-month {
  background: linear-gradient(135deg, rgba(0, 212, 255, 0.12) 0%, #0d1b2e 60%);
}

.earn-month::before {
  background: var(--color-primary);
}

.earn-total {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, #0d1b2e 60%);
}

.earn-total::before {
  background: var(--color-success);
}

.earn-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.earn-amount {
  display: flex;
  align-items: baseline;
}

.earn-symbol {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-right: 6rpx;
}

.earn-value {
  min-width: 0;
  max-width: 100%;
  font-size: 52rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}

.earn-sub {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ===== 菜单列表 ===== */
.menu-list {
  background: linear-gradient(135deg, #112441 0%, #0d1b2e 100%);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-border);
  transition: background 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--color-card-hover);
}

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-order {
  background: rgba(0, 212, 255, 0.15);
  border: 2rpx solid rgba(0, 212, 255, 0.2);
}

.icon-card {
  background: rgba(16, 185, 129, 0.15);
  border: 2rpx solid rgba(16, 185, 129, 0.2);
}

.icon-phone {
  background: rgba(245, 158, 11, 0.15);
  border: 2rpx solid rgba(245, 158, 11, 0.2);
}

.icon-about {
  background: rgba(139, 92, 246, 0.15);
  border: 2rpx solid rgba(139, 92, 246, 0.2);
}

.menu-icon-inner {
  width: 32rpx;
  height: 32rpx;
}

.icon-order-inner {
  border: 3rpx solid var(--color-primary);
  border-radius: 6rpx;
  position: relative;
}

.icon-order-inner::before {
  content: '';
  position: absolute;
  top: 25%;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  height: 50%;
  background: var(--color-primary);
}

.icon-card-inner {
  background: var(--color-success);
  border-radius: 4rpx;
  position: relative;
}

.icon-card-inner::before {
  content: '';
  position: absolute;
  top: 30%;
  left: 20%;
  width: 60%;
  height: 2rpx;
  background: #0a1628;
}

.icon-phone-inner {
  border: 3rpx solid var(--color-warning);
  border-radius: 4rpx 12rpx 12rpx 4rpx;
  position: relative;
}

.icon-phone-inner::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 25%;
  transform: translateY(-50%);
  width: 50%;
  height: 50%;
  border: 2rpx solid var(--color-warning);
  border-radius: 50%;
}

.icon-about-inner {
  border: 3rpx solid #a78bfa;
  border-radius: 50%;
  position: relative;
}

.icon-about-inner::before {
  content: '';
  position: absolute;
  top: 20%;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #a78bfa;
  box-shadow: 0 12rpx 0 #a78bfa;
}

.menu-content {
  flex: 1;
  min-width: 0;
}

.menu-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  display: block;
  margin-bottom: 4rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
  display: block;
}

.menu-arrow {
  font-size: 32rpx;
  color: var(--color-text-muted);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ===== 底部信息 ===== */
.footer-info {
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.footer-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.footer-text {
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.8;
}

/* ===== 登录弹窗 ===== */
.login-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.login-modal {
  width: 600rpx;
  background: linear-gradient(135deg, #112441 0%, #0d1b2e 100%);
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--color-border);
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.6);
  padding: 48rpx 40rpx 40rpx;
  position: relative;
  overflow: hidden;
  animation: modalSlideIn 0.3s ease-out;
}

@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: translateY(60rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.login-modal-bg-glow {
  position: absolute;
  top: -80rpx;
  left: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(0, 212, 255, 0.12) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.login-close {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.close-icon {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}

.close-icon::before,
.close-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 3rpx;
  background: var(--color-text-muted);
  border-radius: 2rpx;
}

.close-icon::before {
  transform: rotate(45deg);
}

.close-icon::after {
  transform: rotate(-45deg);
}

.login-header {
  text-align: center;
  margin-bottom: 40rpx;
  position: relative;
}

.login-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  background: rgba(0, 212, 255, 0.1);
  border: 1rpx solid rgba(0, 212, 255, 0.2);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.login-badge text {
  font-size: 22rpx;
  color: var(--color-primary);
  margin-left: 8rpx;
}

.badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.login-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.login-form {
  position: relative;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  display: block;
}

.avatar-picker {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx dashed var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: normal;
}

.avatar-picker::after {
  border: none;
}

.avatar-preview {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
}

.avatar-placeholder {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0 32rpx;
  color: var(--color-text);
  font-size: 30rpx;
}

.input-placeholder {
  color: var(--color-text-muted);
}

.phone-btn {
  flex-shrink: 0;
  width: 200rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: normal;
}

.phone-btn::after {
  border: none;
}

.phone-btn-content text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.phone-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.phone-or {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.phone-input {
  flex: 1;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.login-confirm {
  margin-top: 40rpx;
}

.login-confirm .btn {
  width: 100%;
}

.login-privacy {
  text-align: center;
  margin-top: 24rpx;
}

.login-privacy text {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* ===== 响应式适配 ===== */
@media screen and (max-width: 320px) {
  .user-name {
    font-size: 36rpx;
  }
  .quick-icon {
    width: 64rpx;
    height: 64rpx;
  }
  .quick-text {
    font-size: 22rpx;
  }
  .menu-name {
    font-size: 28rpx;
  }
}

/* iPhone X 及以上底部安全区 */
@supports (padding-bottom: env(safe-area-inset-bottom)) {
  .footer-info {
    padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  }
}
